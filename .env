# Staging environment (branch: staging -> staging-admin.snptaxes.com -> 9xxx services)
# Every REACT_APP_* var used in src/ must be defined here. There are no code-side
# fallbacks, so a missing var surfaces immediately instead of silently hitting prod.

CI=false
DISABLE_ESLINT_PLUGIN=true

REACT_APP_BASE_PATH=/admin
REACT_APP_CLIENT_URL=https://staging-admin.snptaxes.com

REACT_APP_AUTH_USER=https://staging-admin.snptaxes.com
REACT_APP_SIDEBAR=https://staging-admin.snptaxes.com
REACT_APP_TEMPLATE=https://staging-admin.snptaxes.com
REACT_APP_ACCOUNT_CONTACT=https://staging-admin.snptaxes.com
REACT_APP_ACCOUNT_NOTE=https://staging-admin.snptaxes.com
REACT_APP_ACCOUNT_TASKS=https://staging-admin.snptaxes.com
REACT_APP_PROPOSAL=https://staging-admin.snptaxes.com
REACT_APP_ORGANIZER=https://staging-admin.snptaxes.com
REACT_APP_FOLDER_MANAGEMENT=https://staging-admin.snptaxes.com
REACT_APP_ESIGNATURE_API=https://staging-admin.snptaxes.com
REACT_APP_CHAT=https://staging-admin.snptaxes.com
REACT_APP_TEAMMATES_CHAT=https://staging-admin.snptaxes.com
REACT_APP_EMAIL_SYNC=https://staging-admin.snptaxes.com
REACT_APP_JOBS=https://staging-admin.snptaxes.com
REACT_APP_INVOICE=https://staging-admin.snptaxes.com
